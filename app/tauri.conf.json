{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trae ACP Gateway",
  "version": "0.12.1",
  "identifier": "com.trae.acp-gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3847",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDQkVDMzdCQUIwODk4NkMKUldSc21BaXJlOE8rWERWV0JwKzEvVFl5S3NHZDlsT21SREZJQVQzQUxySkFsOUZmMnFlbXV0QngK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/yu1ec/trae-acp-gateway/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/yu1ec/trae-acp-gateway/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/yu1ec/trae-acp-gateway/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
