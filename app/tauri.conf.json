{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trae ACP Gateway",
  "version": "0.1.0",
  "identifier": "com.trae.acp-gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3847",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
